# Rust build artifacts
/target/
**/target/

# Per-crate target dirs (see crates/*/ .cargo/config.toml) live under /target/

# Application workspace: commit Cargo.lock for reproducible builds (do not ignore)

# rustfmt / tooling backups
*.rs.bk

# Profiling and coverage (if used)
*.profraw
*.profdata
coverage/
lcov.info
tarpaulin-report.html

# Local environment and secrets
.env
.env.*
!.env.example

# Editor and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log

# Kilo (local agent tooling; includes node_modules)
.kilo/

# Replay / simulation outputs (generated; keep fixtures under scenarios/ tracked)
scenarios/generated/
replay/out/
